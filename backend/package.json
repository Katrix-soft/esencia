{
  "name": "esencia-backend",
  "version": "1.0.0",
  "description": "Esencia SaaS — Backend API (Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "start":          "node server.js",
    "dev":            "node --watch server.js",
    "migrate":        "node db/migrate.js",
    "seed":           "node db/seed.js",
    "test":           "jest --forceExit --detectOpenHandles",
    "test:coverage":  "jest --coverage --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch":       ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["routes/**/*.js", "lib/**/*.js", "middleware/**/*.js"]
  },
  "dependencies": {
    "axios":            "^1.7.2",
    "bcryptjs":         "^2.4.3",
    "cors":             "^2.8.5",
    "dotenv":           "^16.4.5",
    "express":          "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet":           "^8.2.0",
    "jsonwebtoken":     "^9.0.3",
    "knex":             "^3.1.0",
    "mercadopago":      "^2.0.15",
    "nodemailer":       "^8.0.11",
    "pg":               "^8.11.5",
    "swagger-ui-express": "^5.0.1",
    "winston":          "^3.13.0",
    "zod":              "^3.23.8"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "supertest": "^7.0.0"
  }
}
